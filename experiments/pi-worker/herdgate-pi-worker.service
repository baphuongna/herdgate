# Experimental local unit for the Pi worker daemon (experiments are NOT shipped —
# copy to ~/.config/systemd/user/ and edit paths before use; the repo checkout must
# stay in place because ExecStart points into it).
[Unit]
Description=Herdgate experimental Pi worker (queue drain, real or fixture provider)
After=network.target

[Service]
Type=simple
# RPC daemon: graceful on stop (SIGTERM aborts the running job into a canceled
# receipt), exits on its own after an idle hour. once-mode owners should use a
# timer instead and drop --mode/--idle-exit.
#
# Provider choice — exactly one of:
#   --real            host Pi's own configured models (auth.json + settings default
#                     model of this user); add --tools to let jobs use tools and
#                     --thinking low|medium|high to pin a level (default: settings)
# --job-timeout bounds one job's wall clock: a hung stream aborts into a
#   failed/job_timeout receipt instead of stalling the queue forever.
#   --fixture-dir ... synthetic no-network provider for tests
ExecStart=/usr/bin/node %h/source/herdgate/experiments/pi-worker/worker.mjs \
  --workspace %h/source/your-project \
  --real \
  --job-timeout 1800 \
  --mode rpc --idle-exit 3600
Environment=HERDGATE_PI_WORKER_DIR=%h/.local/state/herdgate/pi-worker
Environment=HERDGATE_PI_RECEIPT_DIR=%h/.local/state/herdgate/pi-receipts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
