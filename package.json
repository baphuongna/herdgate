{
  "name": "@bom0792/herdgate",
  "version": "0.9.5",
  "description": "Cloud relay hub for herdr-core: every machine dials out, phones and browsers follow (PWA + SSH leg, E2E payloads).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cloud/main.ts",
    "host": "node src/host/main.ts",
    "edge": "node src/dev/main.ts",
    "test": "node --test test/*.test.ts",
    "check": "tsc -p tsconfig.json",
    "ssh-bridge": "node src/cloud/ssh-bridge.ts",
    "postinstall": "node scripts/patch-ssh2.mjs"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  },
  "bin": {
    "herdgate": "bin/herdgate.mjs"
  },
  "files": [
    "bin",
    "src",
    "app-mod",
    "plugin",
    "scripts",
    "dist-readme.md"
  ]
}