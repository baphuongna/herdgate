{
  "name": "herdgate",
  "version": "0.8.1",
  "description": "A cloud relay hub: desktop host agents and mobile devices meet behind one gate.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/cloud/main.ts",
    "host": "node src/host/main.ts",
    "edge": "node src/dev/main.ts",
    "test": "node --test test/*.test.ts",
    "check": "tsc -p tsconfig.json",
    "ssh-bridge": "node src/cloud/ssh-bridge.ts"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
