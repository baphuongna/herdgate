# Public DNS hostname only; no scheme, path, port or credentials.
HERDGATE_PUBLIC_HOST=gate.example.com
# Local HTTP port for Caddy, nginx or cloudflared on the Docker host.
HERDGATE_HTTP_PORT=8787
# On Linux set these to id -u and id -g of the non-root user owning data/ and owner-token.
HERDGATE_UID=1000
HERDGATE_GID=1000
# Optional: hint to native SSH clients (for example the public TCP edge hostname).
# HERDGATE_SSH_HOST=ssh.example.com
# Optional: enable restricted PWA push wake, off by default.
# HERDGATE_ENABLE_PUSH=1
# HERDGATE_PUSH_SUB=mailto:admin@example.com
# Behind a header-forwarding proxy: per-client abuse budgets from the real IP.
# HERDGATE_TRUSTED_PROXY=1
# HERDGATE_REAL_IP_HEADER=CF-Connecting-IP
# A raw TCP edge shares one address; size the SSH-over-WSS budget for it.
# HERDGATE_SSH_TUNNELS_PER_IP=24
# HERDGATE_SSH_TUNNELS_TOTAL=64
